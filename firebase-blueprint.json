{
  "entities": {
    "CatalogMedia": {
      "title": "CatalogMedia",
      "description": "A movie or TV series entry in the Zappy streaming catalog, linked to an EmbedMaster stream, JustWatch artwork, and cast/director profiles with photos.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "tmdbId": {
          "type": "integer",
          "minimum": 1
        },
        "mediaType": {
          "type": "string",
          "enum": ["movie", "tv"]
        },
        "contentType": {
          "type": "string",
          "enum": ["movie", "series"]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "tagline": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "synopsis": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "genres": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 40
          },
          "minItems": 1,
          "maxItems": 6
        },
        "releaseYear": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2100
        },
        "durationMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "maturityRating": {
          "type": "string",
          "enum": ["G", "PG", "PG-13", "TV-PG", "TV-14"]
        },
        "directorOrCreator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "cast": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 100
          },
          "minItems": 1,
          "maxItems": 10
        },
        "creditsJson": {
          "type": "string",
          "maxLength": 15000
        },
        "posterUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "backdropUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "cinesrcEmbedUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "justWatchUrl": {
          "type": "string",
          "maxLength": 1024
        },
        "featured": {
          "type": "boolean"
        },
        "popularScore": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "seasonsCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "episodesCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5000
        },
        "visibility": {
          "type": "string",
          "enum": ["public", "hidden"]
        },
        "authorUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "tmdbId",
        "mediaType",
        "contentType",
        "title",
        "tagline",
        "synopsis",
        "genres",
        "releaseYear",
        "durationMinutes",
        "maturityRating",
        "directorOrCreator",
        "cast",
        "creditsJson",
        "posterUrl",
        "backdropUrl",
        "cinesrcEmbedUrl",
        "justWatchUrl",
        "featured",
        "popularScore",
        "seasonsCount",
        "episodesCount",
        "visibility",
        "authorUid",
        "createdAt",
        "updatedAt"
      ]
    },
    "WatchlistItem": {
      "title": "WatchlistItem",
      "description": "A user's saved watchlist entry in Zappy.",
      "type": "object",
      "properties": {
        "mediaId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["mediaId", "ownerId", "createdAt"]
    },
    "SupportMessage": {
      "title": "SupportMessage",
      "description": "A support ticket or message submitted by a user on the Zappy Support page and visible in the Admin Studio panel.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "firstName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "lastName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        },
        "phone": {
          "type": "string",
          "maxLength": 40
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "senderUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "status": {
          "type": "string",
          "enum": ["unread", "resolved"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "firstName",
        "lastName",
        "email",
        "phone",
        "message",
        "senderUid",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "UiConfig": {
      "title": "UiConfig",
      "description": "Global live visual UI component overrides configured by the Zappy admin.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "overridesJson": {
          "type": "string",
          "maxLength": 50000,
          "description": "JSON-serialized map of CSS selectors to component style/text/deletion overrides."
        },
        "authorUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "overridesJson", "authorUid", "updatedAt"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Admin role marker document keyed by user UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "role": {
          "type": "string",
          "enum": ["admin"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "role", "createdAt"]
    },
    "RegisteredEmail": {
      "title": "RegisteredEmail",
      "description": "Registry of verified registered email addresses used for smart login vs signup flows.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        },
        "displayName": {
          "type": "string",
          "maxLength": 120
        },
        "uid": {
          "type": "string",
          "maxLength": 128
        },
        "registeredAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["email"]
    },
    "OtpChallenge": {
      "title": "OtpChallenge",
      "description": "Temporary salted 6-digit OTP challenge for email verification with expiration.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        },
        "challengeHash": {
          "type": "string",
          "maxLength": 128
        },
        "salt": {
          "type": "string",
          "maxLength": 64
        },
        "expiresAtMs": {
          "type": "integer"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["email", "challengeHash", "salt", "expiresAtMs"]
    }
  },
  "firestore": {
    "/catalog/{mediaId}": {
      "schema": {
        "$ref": "#/entities/CatalogMedia"
      },
      "description": "Publicly readable catalog of movies and TV shows managed exclusively by the Zappy admin."
    },
    "/watchlists/{watchlistDocId}": {
      "schema": {
        "$ref": "#/entities/WatchlistItem"
      },
      "description": "User watchlist items scoped to ownerId == request.auth.uid."
    },
    "/support_messages/{messageId}": {
      "schema": {
        "$ref": "#/entities/SupportMessage"
      },
      "description": "Support messages submitted by users and readable/manageable by the Zappy admin."
    },
    "/ui_config/{configId}": {
      "schema": {
        "$ref": "#/entities/UiConfig"
      },
      "description": "Publicly readable, admin-writable live UI customization overrides."
    },
    "/admins/{adminUid}": {
      "schema": {
        "$ref": "#/entities/AdminRecord"
      },
      "description": "Admin lookup table."
    },
    "/registered_emails/{emailDocId}": {
      "schema": {
        "$ref": "#/entities/RegisteredEmail"
      },
      "description": "Publicly queryable email registry for automated smart login redirection."
    },
    "/otp_challenges/{challengeId}": {
      "schema": {
        "$ref": "#/entities/OtpChallenge"
      },
      "description": "Single-use salted OTP challenges with automated expiry."
    }
  }
}
