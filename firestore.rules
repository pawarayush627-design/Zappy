rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net — Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email_verified == true && (
          request.auth.token.email == 'pawarayushai1@gmail.com' ||
          request.auth.token.email == 'admin@zappy.app'
        )) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // 3. Entity Validation Blueprints
    function isValidCatalogMedia(data) {
      return data.keys().hasAll([
          'id', 'tmdbId', 'mediaType', 'contentType', 'title', 'tagline',
          'synopsis', 'genres', 'releaseYear', 'durationMinutes', 'maturityRating',
          'directorOrCreator', 'cast', 'creditsJson', 'posterUrl', 'backdropUrl',
          'cinesrcEmbedUrl', 'justWatchUrl', 'featured', 'popularScore',
          'seasonsCount', 'episodesCount', 'visibility', 'authorUid',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.tmdbId is int && data.tmdbId > 0 &&
        data.mediaType is string && data.mediaType in ['movie', 'tv'] &&
        data.contentType is string && data.contentType in ['movie', 'series'] &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
        data.tagline is string && data.tagline.size() <= 300 &&
        data.synopsis is string && data.synopsis.size() <= 4000 &&
        data.genres is list && data.genres.size() >= 1 &&
        data.releaseYear is int && data.releaseYear >= 1900 && data.releaseYear <= 2100 &&
        data.durationMinutes is int && data.durationMinutes >= 1 && data.durationMinutes <= 1000 &&
        data.maturityRating is string && data.maturityRating.size() >= 1 && data.maturityRating.size() <= 30 &&
        data.directorOrCreator is string && data.directorOrCreator.size() <= 200 &&
        data.cast is list &&
        data.creditsJson is string && data.creditsJson.size() <= 30000 &&
        data.posterUrl is string && data.posterUrl.size() <= 2048 &&
        data.backdropUrl is string && data.backdropUrl.size() <= 2048 &&
        data.cinesrcEmbedUrl is string && data.cinesrcEmbedUrl.size() <= 1024 &&
        data.justWatchUrl is string && data.justWatchUrl.size() <= 1024 &&
        data.featured is bool &&
        data.popularScore is int && data.popularScore >= 1 && data.popularScore <= 100 &&
        data.seasonsCount is int && data.seasonsCount >= 0 && data.seasonsCount <= 100 &&
        data.episodesCount is int && data.episodesCount >= 0 && data.episodesCount <= 5000 &&
        data.visibility is string && data.visibility in ['public', 'hidden'] &&
        isValidId(data.authorUid) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidWatchlistItem(data) {
      return data.keys().hasAll(['mediaId', 'ownerId', 'createdAt']) &&
        data.keys().hasOnly(['mediaId', 'ownerId', 'createdAt']) &&
        isValidId(data.mediaId) &&
        isValidId(data.ownerId) &&
        data.ownerId == request.auth.uid &&
        data.createdAt is timestamp;
    }

    function isValidSupportMessage(data) {
      return data.keys().hasAll([
          'id', 'firstName', 'lastName', 'email', 'phone',
          'message', 'senderUid', 'status', 'createdAtMs', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'firstName', 'lastName', 'email', 'phone',
          'message', 'senderUid', 'status', 'createdAtMs', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.firstName is string && data.firstName.size() >= 1 && data.firstName.size() <= 80 &&
        data.lastName is string && data.lastName.size() >= 1 && data.lastName.size() <= 80 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        data.phone is string && data.phone.size() <= 40 &&
        data.message is string && data.message.size() >= 1 && data.message.size() <= 2000 &&
        isValidId(data.senderUid) &&
        data.status is string && data.status in ['open', 'unread', 'resolved'] &&
        data.createdAtMs is int && data.createdAtMs > 0 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidUiConfig(data) {
      return data.keys().hasAll(['id', 'overridesJson', 'authorUid', 'updatedAt']) &&
        isValidId(data.id) &&
        data.overridesJson is string && data.overridesJson.size() <= 50000 &&
        isValidId(data.authorUid) &&
        data.updatedAt is timestamp;
    }

    // 4. Collection Rules: /catalog/{mediaId}
    match /catalog/{mediaId} {
      allow get: if isValidId(mediaId) && (existing().visibility == 'public' || isAdmin());
      allow list: if true;

      allow create: if isValidId(mediaId) &&
        isValidCatalogMedia(incoming()) &&
        incoming().id == mediaId &&
        isAdmin();

      allow update: if isValidId(mediaId) &&
        isValidCatalogMedia(incoming()) &&
        incoming().id == existing().id &&
        isAdmin();

      allow delete: if isValidId(mediaId) && isAdmin();
    }

    // 5. Collection Rules: /watchlists/{watchlistDocId}
    match /watchlists/{watchlistDocId} {
      allow get: if isVerifiedUser() && isValidId(watchlistDocId) && (existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isVerifiedUser() && (existing().ownerId == request.auth.uid || isAdmin());

      allow create: if isVerifiedUser() &&
        isValidId(watchlistDocId) &&
        isValidWatchlistItem(incoming()) &&
        incoming().createdAt == request.time;

      allow update: if false;

      allow delete: if isVerifiedUser() && isValidId(watchlistDocId) && (existing().ownerId == request.auth.uid || isAdmin());
    }

    // 6. Collection Rules: /support_messages/{messageId}
    match /support_messages/{messageId} {
      allow get: if isValidId(messageId) && isAdmin();
      allow list: if isAdmin();

      allow create: if isVerifiedUser() &&
        isValidId(messageId) &&
        isValidSupportMessage(incoming()) &&
        incoming().id == messageId &&
        incoming().senderUid == request.auth.uid &&
        incoming().status in ['open', 'unread'] &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isVerifiedUser() &&
        isValidId(messageId) &&
        isValidSupportMessage(incoming()) &&
        incoming().id == existing().id &&
        incoming().senderUid == existing().senderUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) &&
        isAdmin();

      allow delete: if isVerifiedUser() && isValidId(messageId) && isAdmin();
    }

    // 7. Collection Rules: /ui_config/{configId} and /ui_overrides/{overrideId}
    match /ui_config/{configId} {
      allow get: if isValidId(configId);
      allow list: if false;
      allow create, update, delete: if isValidId(configId) && isAdmin();
    }

    match /ui_overrides/{overrideId} {
      allow get: if isValidId(overrideId);
      allow list: if false;
      allow create, update, delete: if isValidId(overrideId) && isAdmin();
    }

    // 8. Collection Rules: /admins/{adminUid}
    match /admins/{adminUid} {
      allow get: if isVerifiedUser() && isValidId(adminUid) && (request.auth.uid == adminUid || isAdmin());
      allow list: if false;
      allow create, update, delete: if false;
    }

    // 9. Collection Rules: /users/{userId} (User Profile: name, age, email)
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // 10. Collection Rules: /registered_emails/{emailDocId} (Registered Account Lookup)
    match /registered_emails/{emailDocId} {
      allow get: if isValidId(emailDocId);
      allow list: if isAdmin();
      allow create, update: if isValidId(emailDocId) &&
        incoming().email is string &&
        incoming().email.size() >= 3 &&
        incoming().email.size() <= 160;
      allow delete: if isAdmin();
    }

    // 11. Collection Rules: /otp_challenges/{challengeId} (Temporary OTP Verification)
    match /otp_challenges/{challengeId} {
      allow get: if isValidId(challengeId);
      allow list: if false;
      allow create, update: if isValidId(challengeId) &&
        incoming().email is string &&
        incoming().email.size() >= 3 &&
        incoming().email.size() <= 160;
      allow delete: if isValidId(challengeId);
    }
  }
}

