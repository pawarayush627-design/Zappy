# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# TMDB_API_KEY: Optional server-side TMDB v3 API Key (or TMDB_READ_ACCESS_TOKEN for v4 Bearer auth).
# Used strictly on the backend (/api/tmdb/*) for live movie and TV metadata discovery.
# Never exposed to client code. Leave empty to use the built-in curated TMDB-ID catalog.
TMDB_API_KEY=""
TMDB_READ_ACCESS_TOKEN=""

# IMA_VAST_TAG_URL: Optional owner-supplied VAST/VMAP ad tag URL for Google IMA HTML5 video ads.
# Leave empty to use Google IMA Development Test Mode when testing ad playback.
IMA_VAST_TAG_URL=""

# IMA_TEST_MODE: Set to "true" to use Google IMA's official sample VAST tag with a clear DEV TEST MODE indicator.
IMA_TEST_MODE="true"

# DEFAULT_TERRITORY: Default ISO 3166-1 alpha-2 territory code used by /api/playback/:mediaType/:tmdbId
DEFAULT_TERRITORY="US"

# AD_SLOTS_ENABLED: Enable ("true") or disable ("false") display banner ad placeholders by default.
AD_SLOTS_ENABLED="true"
